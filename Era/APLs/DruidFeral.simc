## Feral Druid (Classic Era 1.15): Cat Form damage and Bear Form tanking, chosen by your current form.
## Sources: Classic Era feral guides (Wowhead Classic Feral DPS / Feral Tank guides, Warcraft Tavern Feral Druid DPS and
## tank guides, the Classic feral community's "Shred, Bite at 5, powershift" raid rotation) and the Era feral sims.
## Behind-the-target, Rip/Rake, Prowl opener, Tiger's Fury, powershifting, Maul/Swipe thresholds and the debuffs are
## controlled in the Druid settings.

actions.precombat+=/mark_of_the_wild,if=!buff.mark_of_the_wild.up&!buff.gift_of_the_wild.up
actions.precombat+=/omen_of_clarity,if=!buff.omen_of_clarity.up
actions.precombat+=/cat_form,if=prefer_cat&!buff.form.up
actions.precombat+=/dire_bear_form,if=!buff.form.up
actions.precombat+=/bear_form,if=!buff.form.up
actions.precombat+=/prowl,if=prowl_wanted&buff.cat_form.up
actions.precombat+=/tigers_fury,if=tf_precombat&buff.cat_form.up&energy.current>=energy.max&!buff.tigers_fury.up

actions+=/run_action_list,name=cat,if=buff.cat_form.up
actions+=/run_action_list,name=bear,if=buff.bear_form.up
actions+=/run_action_list,name=caster,if=buff.moonkin_form.up
actions+=/cat_form,if=prefer_cat
actions+=/dire_bear_form
actions+=/bear_form
actions+=/cat_form
actions+=/run_action_list,name=caster

## Cat Form.
## Openers from Prowl: Ravage from behind, otherwise Pounce.  Behind the target Shred is always better than Claw, so
## Claw is only used when you are not behind (it would otherwise be picked whenever it is affordable sooner).
actions.cat+=/ravage,if=ravage_opener
actions.cat+=/pounce
actions.cat+=/tigers_fury,if=tf_combat&!buff.tigers_fury.up&energy.current>=80
actions.cat+=/faerie_fire_feral,if=settings.faerie_fire&!debuff.faerie_fire.up&target.time_to_die>10
## Powershift (setting): shift out and back in for Furor / Wolfshead energy when energy is low.
actions.cat+=/cat_form,if=powershift_now
## 5 combo points: Rip when bleeds are wanted and the target lives long enough, otherwise Ferocious Bite.
actions.cat+=/rip,if=combo_points.current>=5&bleeds_wanted&!debuff.rip.up&target.time_to_die>=settings.rip_ttd
actions.cat+=/ferocious_bite,if=combo_points.current>=5
actions.cat+=/ferocious_bite,if=combo_points.current>=3&target.time_to_die<4
actions.cat+=/rake,if=bleeds_wanted&!debuff.rake.up&!buff.clearcasting.up&combo_points.current<5&target.time_to_die>9
actions.cat+=/shred,if=behind_target
actions.cat+=/claw,if=!behind_target|!action.shred.known
## Free filler while waiting for energy.
actions.cat+=/faerie_fire_feral,if=settings.faerie_fire&debuff.faerie_fire.remains<10

## Bear Form (tanking).
actions.bear+=/feral_charge,use_off_gcd=1,if=target.outside7&target.within25
actions.bear+=/bash
actions.bear+=/frenzied_regeneration,if=health.pct<settings.frenzied_regen_pct&rage.current>=30
actions.bear+=/enrage,use_off_gcd=1,if=rage.current<20
actions.bear+=/growl,use_off_gcd=1,if=settings.growl_taunt&group&!aggro&time>0
actions.bear+=/demoralizing_roar,if=(settings.demo_roar|active_enemies>2)&debuff.demoralizing_roar.remains<3&!debuff.demoralizing_shout.up
actions.bear+=/swipe,if=active_enemies>1
actions.bear+=/maul,use_off_gcd=1,if=active_enemies=1&rage.current>=settings.maul_rage_threshold
actions.bear+=/maul,use_off_gcd=1,if=active_enemies>1&rage.current>=action.swipe.cost+action.maul.cost
actions.bear+=/faerie_fire_feral,if=settings.faerie_fire&!debuff.faerie_fire.up
actions.bear+=/swipe,if=rage.current>=settings.swipe_rage_threshold
## Rage-free threat while waiting for rage.
actions.bear+=/faerie_fire_feral,if=settings.faerie_fire

## Caster form, before Bear Form (level 10) and Cat Form (level 20).
actions.caster+=/moonfire,if=!debuff.moonfire.up&target.time_to_die>6
actions.caster+=/wrath
