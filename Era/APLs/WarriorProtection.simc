## Protection Warrior (Classic Era 1.15)
## For characters with most points in Protection.  Always tanks; the same tank list is used by the Fury and Arms
## priorities in Defensive Stance (Tank Mode), which is how most Era tanks (dual-wield Fury/Protection) play.

actions.precombat+=/battle_shout,if=buff.battle_shout.remains<30

actions+=/call_action_list,name=init
actions+=/run_action_list,name=tank

actions.init+=/variable,name=execute_phase,value=target.health.pct<20
actions.init+=/variable,name=can_queue,value=!variable.execute_phase|settings.execute_queueing
actions.init+=/variable,name=strike_over_execute,value=settings.execute_bt_ap>0&stat.attack_power>=settings.execute_bt_ap
actions.init+=/variable,name=should_sunder,value=settings.debuff_sunder_enabled&target.time_to_die>((5-debuff.sunder_armor.stack)*1.5)+3
## Opener Sunder (setting "Open With Sunder Armor"): first attack of the fight, until a Sunder has been cast.
actions.init+=/variable,name=opener_sunder,value=opener_sunder_wanted&time<10&action.sunder_armor.time_since>time&!prev_gcd.1.sunder_armor
actions.init+=/variable,name=opener_sunder_now,value=variable.opener_sunder&rage.current>=action.sunder_armor.cost

## Tanking (Tank Mode setting, or the Protection priority).  Era tanks are mostly dual-wield Fury/Protection in
## Defensive Stance; shield abilities are only recommended with a shield equipped.
actions.tank+=/shield_bash
actions.tank+=/charge,if=target.outside8
## Pulling from Battle/Berserker Stance: Sunder first if the swap would otherwise throw rage away, then Defensive Stance.
actions.tank+=/sunder_armor,if=!buff.defensive_stance.up&rage.current>=action.sunder_armor.cost&rage.current>stance_rage_retained
actions.tank+=/defensive_stance,use_off_gcd=1
actions.tank+=/taunt,if=settings.tank_taunt&time>0&!aggro
actions.tank+=/last_stand,if=settings.tank_last_stand_pct>0&health.pct<settings.tank_last_stand_pct
actions.tank+=/shield_wall,if=settings.tank_last_stand_pct>0&health.pct<settings.tank_last_stand_pct*0.5
actions.tank+=/bloodrage,use_off_gcd=1,if=rage.deficit>=20
actions.tank+=/shield_block,use_off_gcd=1,if=settings.tank_shield_block&aggro&rage.current>=25&!buff.shield_block.up
## Heroic Strike is the single-target rage dump: above the threshold (keeping enough for a ready Bloodthirst), or whenever
## Bloodthirst is on cooldown and a Sunder Armor is still affordable afterwards (about as much threat per rage as
## Bloodthirst, and no global cooldown).
actions.tank+=/heroic_strike,use_off_gcd=1,if=active_enemies=1&(rage.current>=settings.tank_hs_rage&(!talent.bloodthirst.enabled|cooldown.bloodthirst.remains>gcd.max|rage.current>=action.heroic_strike.cost+action.bloodthirst.cost)|talent.bloodthirst.enabled&cooldown.bloodthirst.remains>gcd.max&rage.current>=action.heroic_strike.cost+action.sunder_armor.cost)
actions.tank+=/cleave,use_off_gcd=1,if=active_enemies>1&rage.current>=settings.tank_cleave_rage
actions.tank+=/battle_shout,if=buff.battle_shout.remains<3
## Bloodthirst or Revenge, when both are ready.  Revenge is the best threat per rage (5 rage), Bloodthirst the best per
## global cooldown (about 2.3x Revenge): with plenty of rage the global cooldown is the limit, so Bloodthirst goes first and
## Revenge follows inside its 5 s window; short on rage, Revenge goes first.  This is what the tanks in the fastest Era
## kills do (tools/wcl_tanks.py).
actions.tank+=/bloodthirst,if=rage.current>=settings.tank_bt_first_rage&buff.revenge_usable.remains>gcd.max
actions.tank+=/revenge
actions.tank+=/shield_slam
actions.tank+=/bloodthirst
actions.tank+=/mortal_strike
## Three or more enemies: Battle Shout's threat is split across every enemy in combat, so it's the AoE rage dump.
actions.tank+=/battle_shout,if=active_enemies>=3&rage.current>=settings.tank_cleave_rage
actions.tank+=/sunder_armor,if=debuff.sunder_armor.stack<5|debuff.sunder_armor.remains<5
actions.tank+=/demoralizing_shout,if=settings.tank_demoshout&debuff.demoralizing_shout.remains<3
## Filler Sunder Armor (about the same threat per rage as Heroic Strike, but it takes a global cooldown): only while it
## can't starve Bloodthirst.
actions.tank+=/sunder_armor,if=!talent.bloodthirst.enabled|rage.current>=action.bloodthirst.cost+action.sunder_armor.cost
